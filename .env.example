# Contact form email delivery (Resend — https://resend.com)
#
# All three are optional in development. With none of them set, the form still
# works end to end: the API route validates the submission, returns success, and
# prints the message to the server console instead of emailing it.
#
# In production (Vercel) RESEND_API_KEY and CONTACT_FROM_EMAIL are required:
# without them the form shows the visitor an error instead of pretending the
# message was sent. Set CONTACT_TO_EMAIL there too, so delivery doesn't depend
# on profile.email being a real inbox.
#
# Copy this file to .env.local and fill it in. Never commit .env.local.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The address messages are sent TO. Defaults to profile.email if unset.
CONTACT_TO_EMAIL=

# The address messages are sent FROM. Must be on a domain you have verified
# in Resend, e.g. "John Omaji <contact@johnomaji.com>". It needs no mailbox:
# replies go to the visitor, because the route sets reply-to to their address.
CONTACT_FROM_EMAIL=
